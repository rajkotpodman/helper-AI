# Helper-AI Environment Configuration

# LLM Provider: 'gemini', 'deepseek', 'custom', 'openai', 'groq', 'ollama', or 'rule_engine'
LLM_PROVIDER=gemini

# API Keys (Provide the one corresponding to your chosen provider)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
GROQ_API_KEY=

# Universal / Custom AI Settings (Use ANY AI in the world: Claude, OpenRouter, Mistral, Grok, LM Studio, vLLM)
CUSTOM_LLM_NAME=OpenRouter
CUSTOM_LLM_URL=https://openrouter.ai/api/v1
CUSTOM_LLM_KEY=
CUSTOM_LLM_MODEL=anthropic/claude-3.5-sonnet

# Ollama Settings (for local 100% offline models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Agent Settings
MAX_STEPS=25
AUTONOMOUS_MODE=true
SAFE_MODE=false
PORT=8000
HOST=127.0.0.1
